# Python-generated files (o build Angular em src/conduto/web/dist é
# versionado de propósito: o install via git precisa dele pronto)
__pycache__/
*.py[oc]
build/
dist/
!src/conduto/web/dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Credentials generated by conduto init
.env

# IDE / editors
.idea/
.vscode/

# Caches and coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Frontend Angular (o build vai para src/conduto/web/dist e viaja no pacote)
node_modules/
web/.angular/

# Projetos de teste locais (scratch)
teste/
meu_projeto/

# Banco DuckDB local e dados do docker-compose
data/
*.duckdb
